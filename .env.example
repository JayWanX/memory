# Memory runtime configuration
MEMORY_DATA_DIR=~/.memory
MEMORY_STORE=default

# Retention. Set MEMORY_MAX_INSIGHTS=0 to disable automatic pruning.
MEMORY_MAX_INSIGHTS=1000
MEMORY_AUTO_PRUNE_MIN_AGE=24h

# Optional embeddings. The defaults below use Ollama.
MEMORY_EMBED_ENDPOINT=http://localhost:11434
MEMORY_EMBED_MODEL=nomic-embed-text

# For an OpenAI-compatible server, replace the endpoint and model above.
# The remaining settings are optional:
# MEMORY_EMBED_ENDPOINT=http://127.0.0.1:18000/v1
# MEMORY_EMBED_MODEL=bge-m3-mlx-8bit
# MEMORY_EMBED_PROTOCOL=openai
# MEMORY_EMBED_API_KEY=sk-...
# MEMORY_EMBED_DIMENSIONS=256
